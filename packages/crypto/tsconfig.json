{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false, "skipLibCheck": true, "isolatedModules": true,
    "noEmit": true, "types": []
  },
  "include": ["src", "test"]
}
