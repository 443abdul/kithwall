<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Kithwall app frame (docs/v2/05-native.md §1). Edge-to-edge is always on (target SDK 36); Capacitor's
         SystemBars plugin turns the window insets into the page's env(safe-area-inset-*) values and the page
         sets the status bar icon colour from its own light/dark mode (lib/native/runtime.ts). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kw_splash_icon_background</item>
        <item name="colorAccent">@color/kw_splash_icon_background</item>
        <item name="android:windowBackground">@color/kw_background</item>
    </style>

    <!-- The theme the activity runs with (BridgeActivity applies it after the splash). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/kw_splash_icon_background</item>
        <item name="colorAccent">@color/kw_splash_icon_background</item>
        <item name="android:windowBackground">@color/kw_background</item>
    </style>

    <!-- Launch: the system splash screen (Android 12+ natively, back-ported to 9–11): the adaptive icon on the
         page colour, held until the first page paints (MainActivity). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kw_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
