<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only (no user-installed CAs, so a CA added to the phone by
     someone else can't intercept the app's traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
