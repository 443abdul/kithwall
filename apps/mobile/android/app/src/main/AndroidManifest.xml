<?xml version="1.0" encoding="utf-8"?>
<!-- Kithwall for Android (docs/v2/05-native.md). Every permission is justified in docs/v2/store/play-listing.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is the website in a WebView, so it needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications (Android 13+ asks the person). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Calls: microphone and camera, only while a call or voice note is in progress (asked at that moment). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Safety check-ins: "Attach my location now" (one reading, only when tapped; sent end-to-end encrypted). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- An incoming call may show over the lock screen (Android 14+: only for calling apps). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- A call keeps its microphone (and camera for video calls) while the person uses another app: a
         "Kithwall call in progress" foreground service, only while a call is connected (KwCallService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Biometric unlock (optional, off by default). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 14+: be told that a screenshot was taken, to show a local notice. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <!-- "Use Tor (Orbot)" (docs/v2/08-censorship.md §4): only to see whether Orbot is installed. -->
    <queries>
        <package android:name="org.torproject.android" />
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".KwApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <!-- The app itself. It has no intent filter of its own: the launcher entries below are aliases of it
             (KwIcons, docs/v2/03-safety.md §13), each with the launcher filter, the verified app links and
             the Kit Drop "open with" / share filters, so all of them work whichever entry is switched on and
             a chooser shows that entry's name and icon. Notifications and the call service open this class
             directly. Exported as before; KwActivity checks a per-install token on anything that asks it to
             open a path (security review L15). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".KwActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:showWhenLocked="false"
            android:exported="true" />

        <!-- The default launcher entry. Its name is the component every home-screen icon made before 2.5.0
             points at (the activity class used to be MainActivity): it must stay exactly this, and enabled. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".KwActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified app links: Kithwall links open in the app (verified through /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${kwHost}" />
            </intent-filter>

            <!-- Kit Drop files (docs/v2/08-censorship.md §5, KwKitDrop): "Open with" from Files, Downloads or
                 Quick Share, and the share sheet. A MIME type without a scheme matches content: URIs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.kithwall.kitdrop+json" />
            </intent-filter>
            <!-- Most apps type a .kwd file by its extension, which Android doesn't know: it arrives as
                 application/octet-stream or application/json. KwKitDrop checks the content before opening it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity-alias>

        <!-- Disguised launcher entries: another name and icon for the same app. Off until chosen in
             Safety centre → App lock → App icon; exactly one entry is enabled at a time (KwIcons). -->
        <activity-alias
            android:name=".IconCalculator"
            android:targetActivity=".KwActivity"
            android:label="@string/kw_icon_calculator"
            android:icon="@mipmap/ic_alt_calculator"
            android:roundIcon="@mipmap/ic_alt_calculator_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified app links: Kithwall links open in the app (verified through /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${kwHost}" />
            </intent-filter>

            <!-- Kit Drop files (docs/v2/08-censorship.md §5, KwKitDrop): "Open with" from Files, Downloads or
                 Quick Share, and the share sheet. A MIME type without a scheme matches content: URIs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.kithwall.kitdrop+json" />
            </intent-filter>
            <!-- Most apps type a .kwd file by its extension, which Android doesn't know: it arrives as
                 application/octet-stream or application/json. KwKitDrop checks the content before opening it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise: Notes. -->
        <activity-alias
            android:name=".IconNotes"
            android:targetActivity=".KwActivity"
            android:label="@string/kw_icon_notes"
            android:icon="@mipmap/ic_alt_notes"
            android:roundIcon="@mipmap/ic_alt_notes_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified app links: Kithwall links open in the app (verified through /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${kwHost}" />
            </intent-filter>

            <!-- Kit Drop files (docs/v2/08-censorship.md §5, KwKitDrop): "Open with" from Files, Downloads or
                 Quick Share, and the share sheet. A MIME type without a scheme matches content: URIs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.kithwall.kitdrop+json" />
            </intent-filter>
            <!-- Most apps type a .kwd file by its extension, which Android doesn't know: it arrives as
                 application/octet-stream or application/json. KwKitDrop checks the content before opening it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise: Weather. -->
        <activity-alias
            android:name=".IconWeather"
            android:targetActivity=".KwActivity"
            android:label="@string/kw_icon_weather"
            android:icon="@mipmap/ic_alt_weather"
            android:roundIcon="@mipmap/ic_alt_weather_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified app links: Kithwall links open in the app (verified through /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${kwHost}" />
            </intent-filter>

            <!-- Kit Drop files (docs/v2/08-censorship.md §5, KwKitDrop): "Open with" from Files, Downloads or
                 Quick Share, and the share sheet. A MIME type without a scheme matches content: URIs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.kithwall.kitdrop+json" />
            </intent-filter>
            <!-- Most apps type a .kwd file by its extension, which Android doesn't know: it arrives as
                 application/octet-stream or application/json. KwKitDrop checks the content before opening it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity-alias>

        <!-- "Call in progress" while a call is connected (microphone / camera keep working in the background). -->
        <service
            android:name=".KwCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Declines an incoming call from its notification (and, with the app running, sends the decline). -->
        <receiver android:name=".CallActionReceiver" android:exported="false" />

        <!-- Incoming call over the lock screen: the call notification's full-screen intent. Its own task, so
             the app (which never shows over the lock screen) isn't brought up with it; no app content in it. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/AppTheme.IncomingCall" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
