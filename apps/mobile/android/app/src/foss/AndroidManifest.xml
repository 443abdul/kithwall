<?xml version="1.0" encoding="utf-8"?>
<!-- foss flavour: UnifiedPush. The distributor app (ntfy, NextPush, …) wakes this service; messages are
     Web Push encrypted to a key made on this phone (the connector library decrypts them). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name=".KwUnifiedPushService" android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
