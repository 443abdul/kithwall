# Copy to .env.local for local development (values printed by `supabase start`), or set in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the account-deletion route and the sign-up hook. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server-only. Random 32+ character secrets.
ALTCHA_HMAC_KEY=
AUTH_HOOK_SECRET=

# Native apps (docs/v2/05-native.md). All server-only; leave empty until the owner checklist is done.
# Android signing-certificate SHA-256 fingerprints, comma-separated (Play app signing key + upload key;
# add the debug key on staging). Published in /.well-known/assetlinks.json and accepted as passkey origins.
ANDROID_CERT_SHA256=
# Apple Developer Team ID (10 characters). /.well-known/apple-app-site-association is served only when set.
APPLE_TEAM_ID=
# Firebase service account JSON (raw or base64) for FCM HTTP v1 (Android "play" build push).
FCM_SERVICE_ACCOUNT_JSON=
# APNs token auth (iOS push): key id, team id, and the .p8 key (PEM, or base64 of it). Optional bundle id.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=

# Censorship resistance (docs/v2/08-censorship.md). All optional; with none set nothing changes.
# NEXT_PUBLIC_API_BASE=/sb
# NEXT_PUBLIC_REALTIME_BASE=
# NEXT_PUBLIC_API_ALTERNATES=
# NEXT_PUBLIC_MIRROR_ORIGINS=
# NEXT_PUBLIC_MIRROR_LIST_PUBKEY=            # node scripts/mirrors.mjs keygen --out <offline path>
# NEXT_PUBLIC_MIRROR_LIST_URLS=              # default: /api/net/mirrors
# KITHWALL_MIRROR_LIST=                      # signed JSON from scripts/mirrors.mjs sign
# NEXT_PUBLIC_ONION_ORIGIN=
# NEXT_PUBLIC_APK_URLS=
# NEXT_PUBLIC_APK_CERT_SHA256=
# KITHWALL_SB_REWRITE=1                      # Vercel forwards /sb/* to Supabase (HTTP only)
