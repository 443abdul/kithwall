{
  "id": "/",
  "name": "Kithwall",
  "short_name": "Kithwall",
  "description": "Your people. Your space. Sealed. A private, end-to-end encrypted social network for the people you actually know. No ads, no tracking.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#fbf6f0",
  "theme_color": "#fbf6f0",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["social"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/landing-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Kithwall: your people, your space, sealed" },
    { "src": "/screenshots/landing-narrow.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Kithwall: your people, your space, sealed" }
  ],
  "shortcuts": [
    { "name": "Messages", "url": "/messages", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Activity", "url": "/activity", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
